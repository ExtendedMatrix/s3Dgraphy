{
  "name": "Generic USM Format",
  "description": "Generic Mapping format for Masonry Stratigraphic Units. Rimossa (2026-09-20) la relazione Tecnica_Costruttiva --combines--> Materiale: nel datamodel `combines` va da un CombinerNode a un ExtractorNode, e fra due proprieta' non e' rappresentabile. Le due proprieta' pendono gia' dalla USM con has_property; il legame fra tecnica e materiale, se serve, chiede un tipo che oggi non c'e' e va chiesto con un caso d'uso, non forzato su un arco che significa altro.",
  "version": "1.6.0",
  "table_settings": {
    "format_type": "xlsx",
    "sheet_name": "USM"
  },
  "column_mappings": {
    "Nome_USM": {
      "node_type": "StratigraphicUnit",
      "is_id": true
    },
    "Lunghezza": {
      "node_type": "PropertyNode",
      "property_name": "Length",
      "display_name": "Length",
      "description": "Length of the wall unit"
    },
    "Altezza": {
      "node_type": "PropertyNode",
      "property_name": "Height",
      "display_name": "Height",
      "description": "Height of the wall unit"
    },
    "Tecnica_Costruttiva": {
      "node_type": "PropertyNode",
      "property_name": "BuildingTechnique",
      "display_name": "Building Technique",
      "description": "Construction technique of the wall"
    },
    "Materiale": {
      "node_type": "PropertyNode",
      "property_name": "Material",
      "display_name": "Material",
      "description": "Main material used in construction"
    }
  },
  "relations": [
    {
      "source_column": "Nome_USM",
      "target_column": "Lunghezza",
      "edge_type": "has_property"
    },
    {
      "source_column": "Nome_USM",
      "target_column": "Altezza",
      "edge_type": "has_property"
    },
    {
      "source_column": "Nome_USM",
      "target_column": "Tecnica_Costruttiva",
      "edge_type": "has_property"
    },
    {
      "source_column": "Nome_USM",
      "target_column": "Materiale",
      "edge_type": "has_property"
    }
  ],
  "allowed_formats": [
    "jpg",
    "jpeg",
    "png",
    "pdf",
    "doc",
    "txt"
  ],
  "_validated_against": {
    "s3dgraphy": "1.6.0.dev22",
    "schema_version": "1",
    "node_datamodel": "1.6.14",
    "connections_datamodel": "1.6.28",
    "on": "2026-09-30"
  }
}
