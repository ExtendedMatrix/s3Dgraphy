{
  "_note": "V1 (4 Oct 2026) · the cases of ONE translation, from a store's change to the wire's operations (s3dgraphy.crdt.OPS). s3Dgraphy's tests/test_op_vocabulary.py runs crdt.ops_for_local_change on each and compares with `ops` (or `error`); EMStudio's tools/ops_golden.py copies this file to frontend/testdata/ops-golden.json with the library's answers, and scripts/check-ops.mjs asks hub.ts opsForLocalChange the same. `study_language` is the study's language passed beside the change.",
  "cases": [
    {"name": "blender description (EMtools patch)",
     "local": {"type": "op", "op": "update_node", "node_id": "US1", "patch": {"description": "muro in opera quadrata"}, "ts": "2026-10-04T09:00:00Z"},
     "ops": [{"op": "update_field", "node_id": "US1", "field": "description", "ts": "2026-10-04T09:00:00Z", "value": "muro in opera quadrata"}]},
    {"name": "studio fields, one emptied (EMStudio)",
     "local": {"op": "update_node", "node_id": "US2", "fields": [
        {"field": "name", "value": "US 2", "ts": "2026-10-04T09:01:00Z", "by": "ed"},
        {"field": "data.dating", "value": null, "ts": "2026-10-04T09:01:00Z", "removed": true}]},
     "ops": [{"op": "update_field", "node_id": "US2", "field": "name", "ts": "2026-10-04T09:01:00Z", "value": "US 2"},
             {"op": "update_field", "node_id": "US2", "field": "data.dating", "ts": "2026-10-04T09:01:00Z", "remove": true}]},
    {"name": "patch with data and a null",
     "local": {"op": "update_node", "node_id": "US3", "patch": {"data": {"url": "D.32.pdf", "dating": null}}},
     "ops": [{"op": "update_field", "node_id": "US3", "field": "data.url", "value": "D.32.pdf"},
             {"op": "update_field", "node_id": "US3", "field": "data.dating", "remove": true}]},
    {"name": "a patch key that is structure is refused by name",
     "local": {"op": "update_node", "node_id": "US3", "patch": {"node_type": "USV"}},
     "error": "'node_type' is not an addressable field"},
    {"name": "new US (EMtools, no language)",
     "local": {"type": "op", "op": "add_node", "node": {"id": "US9", "name": "US 9", "node_type": "US", "description": ""}},
     "study_language": "it",
     "ops": [{"op": "add_node", "id": "US9", "node": {"id": "US9", "name": "US 9", "node_type": "US", "description": "", "data": {"lang": "it"}}}]},
    {"name": "new node with its own language and stamp",
     "local": {"op": "add_node", "node": {"id": "D1", "node_type": "document", "name": "D.1", "data": {"lang": "en", "created_at": "2026-10-04T09:02:00Z"}}},
     "ops": [{"op": "add_node", "id": "D1", "node": {"id": "D1", "node_type": "document", "name": "D.1", "data": {"lang": "en", "created_at": "2026-10-04T09:02:00Z"}}, "ts": "2026-10-04T09:02:00Z"}]},
    {"name": "new node, no study language: und",
     "local": {"op": "add_node", "node": {"id": "US10", "node_type": "US"}},
     "ops": [{"op": "add_node", "id": "US10", "node": {"id": "US10", "node_type": "US", "data": {"lang": "und"}}}]},
    {"name": "delete a node",
     "local": {"op": "delete_node", "node_id": "US9"},
     "ops": [{"op": "remove_node", "id": "US9"}]},
    {"name": "the Sidecar's nested edge reaches the room with its endpoints",
     "local": {"type": "op", "op": "add_edge", "edge": {"id": "US9_is_after_US1", "source": "US9", "target": "US1", "edge_type": "is_after"}},
     "ops": [{"op": "add_edge", "id": "US9_is_after_US1", "source": "US9", "target": "US1", "edge_type": "is_after"}]},
    {"name": "an heir's declared attribute travels, the clock keys do not",
     "local": {"op": "add_edge", "edge": {"id": "e1", "source": "US1", "target": "P1", "edge_type": "has_property", "attributes": {"inherited": true, "created_at": "x", "removed": {"ts": "y"}}}},
     "ops": [{"op": "add_edge", "id": "e1", "source": "US1", "target": "P1", "edge_type": "has_property", "attributes": {"inherited": true}}]},
    {"name": "delete an edge",
     "local": {"op": "delete_edge", "edge": {"id": "e1", "source": "US1", "target": "P1", "edge_type": "has_property"}},
     "ops": [{"op": "remove_edge", "id": "e1", "source": "US1", "target": "P1", "edge_type": "has_property"}]},
    {"name": "a wire operation passes as it is",
     "local": {"op": "update_field", "node_id": "US1", "field": "data.lang", "value": "it", "ts": "2026-10-04T09:03:00Z"},
     "ops": [{"op": "update_field", "node_id": "US1", "field": "data.lang", "value": "it", "ts": "2026-10-04T09:03:00Z"}]},
    {"name": "an edge without endpoints is refused, not sent",
     "local": {"op": "add_edge", "edge": {"id": "e2"}},
     "error": "add_edge without source, target, edge_type"},
    {"name": "a verb nobody speaks",
     "local": {"op": "rename_node", "node_id": "US1"},
     "error": "unknown operation 'rename_node'"}
  ]
}
