# ESEMPIO INVENTATO (D-5) — non citare. / INVENTED EXAMPLE — not to be cited.
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix v:    <https://w3id.org/extendedmatrix/profile/esempio-statuaria/vocab/lavorazione/> .

v: a skos:ConceptScheme ;
    dct:title "Lavorazione (ESEMPIO)"@it , "Working (EXAMPLE)"@en ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    owl:versionInfo "0.1.0" .

v:subbia a skos:Concept ; skos:inScheme v: ; skos:topConceptOf v: ;
    skos:prefLabel "subbia"@it , "point chisel"@en ;
    dct:source "Esempio scritto per la SPEC dei pacchetti di comunità." .

v:gradina a skos:Concept ; skos:inScheme v: ; skos:topConceptOf v: ;
    skos:prefLabel "gradina"@it , "claw chisel"@en ;
    dct:source "Esempio scritto per la SPEC dei pacchetti di comunità." .

v:trapano a skos:Concept ; skos:inScheme v: ; skos:topConceptOf v: ;
    skos:prefLabel "trapano"@it , "drill"@en ;
    dct:source "Esempio scritto per la SPEC dei pacchetti di comunità." .
