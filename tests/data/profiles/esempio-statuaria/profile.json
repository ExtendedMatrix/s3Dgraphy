  "lifecycle": "proposed",
  "example": true,
  "title": {
    "it": "Lettura stratigrafica della statuaria (ESEMPIO)",
    "en": "Stratigraphic reading of statuary (EXAMPLE)"
  },
  "description": {
    "it": "Pacchetto d'esempio sintetico (D-5). Non citare.",
    "en": "Synthetic example package (D-5). Not to be cited."
  },
  "languages": [
