       "id": "US1",
       "node_type": "US",
       "name": "US1"
      }
     ],
     "edges": []
    },
    "layout": {
     "positions": {
      "US1": {
       "x": 10,
       "y": 0,
       "w": 90,
       "h": 30
      }
     }
    }
   },
   "expect": {
    "layouts": {
